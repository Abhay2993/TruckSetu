{
  "expo": {
    "name": "TruckSetu",
    "slug": "trucksetu",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#0F2A5C",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F2A5C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trucksetu.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.trucksetu.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F2A5C"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "TruckSetu uses the camera to capture Proof of Delivery (POD) documents so escrow payments can be released."
        }
      ],
      "expo-notifications"
    ]
  }
}
